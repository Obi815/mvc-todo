<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/todos/createTodos" method="post">
        <input type="text" placeholder="Add Todo" name="userTodo">
        <button>Add</button>
    </form>

    <!--  * Creating li for each todo? -->
    <% todos.forEach(todoItem => { %>
        <li><%= todoItem.todo %></li>
    <% }) %>
</body>
</html>